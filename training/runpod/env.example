# Copy to training/runpod/.env.local (not committed) and fill in; launch.sh reads these from the
# environment. Never put secret VALUES here: reference RunPod secrets instead.

# --- runpodctl ---------------------------------------------------------------
# RUNPOD_API_KEY is read by runpodctl from the environment (runpodctl README, "environment
# variables"). Export it in your shell; launch.sh never prints or stores it.
# export RUNPOD_API_KEY=...

PHYS_GRPO_IMAGE=registry.example.com/you/physiology-grpo:v0      # image built from training/runpod/Dockerfile
PHYS_GRPO_POD_NAME=physiology-grpo
PHYS_GRPO_GPU_ID="NVIDIA H100 80GB HBM3"                        # from `runpodctl gpu list`
PHYS_GRPO_GPU_COUNT=1
PHYS_GRPO_CLOUD_TYPE=SECURE                                     # SECURE | COMMUNITY
PHYS_GRPO_CONTAINER_DISK_GB=100
PHYS_GRPO_VOLUME_GB=200                                         # ignored if a network volume is given
PHYS_GRPO_NETWORK_VOLUME_ID=                                    # optional, from `runpodctl network-volume list`
PHYS_GRPO_REGISTRY_AUTH_ID=                                     # optional, from `runpodctl registry list`
PHYS_GRPO_MODE=smoke                                            # smoke | train | dataset | shell

# --- trainer config overrides passed into the pod (PHYS_GRPO__<section>__<key>) ---
PHYS_GRPO__model__base_model=CHOOSE_BASE_MODEL__any/hf-model-id # placeholder: Nikhil chooses
PHYS_GRPO__grpo__group_size=8
PHYS_GRPO__trainer__n_gpus_per_node=1

# --- secrets: names of RunPod secrets (console -> Secrets), referenced as {{ RUNPOD_SECRET_<name> }}
PHYS_GRPO_HF_SECRET_NAME=huggingface_token
PHYS_GRPO_BEAM_SECRET_NAME=beam_token
